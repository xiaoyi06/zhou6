<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zhou6</groupId>
        <artifactId>zhou6</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 账户服务模块：现金余额账户、账户流水、缓存原子变更和 MQ 消费链路。 -->
    <artifactId>account-service</artifactId>
    <name>account-service</name>
    <description>Cash account service with Redis atomic balance operations and PostgreSQL audit ledger</description>

    <dependencies>
        <!-- 公共契约依赖：统一使用 R 响应体、业务异常和公共错误处理。 -->
        <dependency>
            <groupId>com.zhou6</groupId>
            <artifactId>common-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MyBatis 公共配置依赖：复用 MyBatis-Plus、分页插件和雪花 ID 生成配置。 -->
        <dependency>
            <groupId>com.zhou6</groupId>
            <artifactId>mybatis-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring MVC Web 依赖：提供账户 REST 接口和内嵌 Tomcat 能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Redis 依赖：存放高频现金快照，并通过 Lua 脚本完成余额原子变更。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Redis 连接池依赖：让 Nacos 中的 spring.data.redis.lettuce.pool 配置真正生效。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- RabbitMQ 依赖：消费订单结算、订单取消解冻等异步账户消息。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动：保存账户快照和只增不改的账户流水审计凭证。 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Swagger / OpenAPI 文档依赖：提供账户服务接口文档。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>
</project>
