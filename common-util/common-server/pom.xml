<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目父工程：继承 Java 21、Spring Boot 和统一构建配置。 -->
    <parent>
        <groupId>com.zhou6</groupId>
        <artifactId>zhou6</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-server</artifactId>
    <name>common-server</name>
    <description>Common contracts and shared utilities for zhou6 services</description>

    <dependencies>
        <!-- MVC 异常处理编译依赖：业务 Web 服务已自行引入 starter-web，这里不向网关等模块传递 Servlet Web 依赖。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 公共 jar 模块没有启动类，不执行 Spring Boot 可执行 jar 重打包。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
