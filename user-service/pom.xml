<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目父工程：继承 Java 21、Spring Boot、Spring Cloud、Spring Cloud Alibaba 的统一版本管理。 -->
    <parent>
        <groupId>com.zhou6</groupId>
        <artifactId>zhou6</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>user-service</artifactId>
    <name>user-service</name>
    <description>User service with database-backed user APIs</description>

    <dependencies>
        <!-- 公共契约依赖：统一使用 R 响应体等跨服务对象。 -->
        <dependency>
            <groupId>com.zhou6</groupId>
            <artifactId>common-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring MVC Web 依赖：为 user-service 提供 REST 接口和内嵌 Tomcat 能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Lombok 依赖：为 DTO 等普通类生成 getter、setter 和构造方法，减少样板代码。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- MyBatis 公共配置依赖：统一使用 MyBatis-Plus 和雪花 ID 生成配置。 -->
        <dependency>
            <groupId>com.zhou6</groupId>
            <artifactId>mybatis-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- PostgreSQL 驱动：连接 81.70.186.59:5432 上的 PostgreSQL 数据库。 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis 依赖：业务服务按 accessToken 中的用户 ID 查询登录会话快照，写入当前用户上下文。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 密码加密依赖：用户管理新增和修改密码时使用 BCrypt。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Swagger / OpenAPI 文档依赖：提供 /swagger-ui/index.html 和 /v3/api-docs。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>
</project>
