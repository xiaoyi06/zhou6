<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目父工程：继承 Java 21、Spring Boot、Spring Cloud、Spring Cloud Alibaba 的统一版本管理。 -->
    <parent>
        <groupId>com.zhou6</groupId>
        <artifactId>zhou6</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 订单服务模块：负责订单状态机、账户预冻结、事务后置 MQ 和退款/取消链路。 -->
    <artifactId>order-service</artifactId>
    <name>order-service</name>
    <description>Order service with payment state machine and account consistency integration</description>

    <dependencies>
        <!-- 公共契约依赖：统一使用 R 响应体、业务异常和公共错误处理。 -->
        <dependency>
            <groupId>com.zhou6</groupId>
            <artifactId>common-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MyBatis 公共配置依赖：复用 MyBatis-Plus、分页插件和雪花 ID 生成配置。 -->
        <dependency>
            <groupId>com.zhou6</groupId>
            <artifactId>mybatis-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring MVC Web 依赖：提供订单 REST 接口和内嵌 Tomcat 能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- OpenFeign 依赖：同步调用 account-service 完成预冻结和冲正。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Spring Cloud LoadBalancer 依赖：让 Feign 按 account-service 服务名从 Nacos 选择实例。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- RabbitMQ 依赖：事务提交后向账户服务发送结算或解冻消息。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动：保存订单主表和订单现金扣减凭证。 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis 依赖：读取登录会话快照，恢复当前用户上下文。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Redis 连接池依赖：让 Nacos 中的 spring.data.redis.lettuce.pool 配置真正生效。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- Swagger / OpenAPI 文档依赖：提供订单服务接口文档。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>
</project>
