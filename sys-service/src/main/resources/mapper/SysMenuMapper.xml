<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhou6.cloud.sys.mapper.SysMenuMapper">

    <select id="selectRouteIconById" resultType="com.zhou6.cloud.sys.mapper.SysMenuMapper$MenuRouteIcon">
        SELECT id AS menuId, route_path AS routePath, icon, menu_name AS menuName
        FROM sys_menu
        WHERE id = #{menuId}
    </select>

</mapper>
