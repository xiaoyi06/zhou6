<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 父工程：统一管理 Spring Boot 依赖版本、插件版本和默认构建配置。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.zhou6</groupId>
    <artifactId>zhou6</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>zhou6</name>
    <description>Java 21 Spring Cloud microservice scaffold</description>

    <modules>
        <module>common-util/common-server</module>
        <module>common-util/mybatis-server</module>
        <module>user-service</module>
        <module>auth-service</module>
        <module>file-service</module>
        <!-- 现金账户微服务：负责用户现金余额快照、流水审计、Redis 原子变更和 RabbitMQ 后置落库链路。 -->
        <module>account-service</module>
        <!-- 订单微服务：负责订单状态机、账户预冻结、事务后置 MQ 和退款/取消链路。 -->
        <module>order-service</module>
        <!-- 工作流微服务：负责 Flowable 流程编排、待办已办查询和业务状态事件通知。 -->
        <module>workflow-service</module>
        <!-- 消息中心微服务：负责站内/站外通知落库、查询和 WebSocket 实时推送。 -->
        <module>message-service</module>
        <!-- 交流社区微服务：负责帖子、评论树、点赞收藏、用户关系、热度和社区内容扩展。 -->
        <module>community-service</module>
        <!-- 系统控制与安全审计微服务：负责动态开关、白名单、字典、登录审计、流量统计和常用菜单统计。 -->
        <module>sys-service</module>
        <module>gateway-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <springdoc-openapi.version>2.6.0</springdoc-openapi.version>
        <flowable.version>7.0.1</flowable.version>
        <minio.version>8.5.12</minio.version>
        <huaweicloud-obs.version>3.23.9</huaweicloud-obs.version>
        <aliyun-oss.version>3.18.1</aliyun-oss.version>
        <tencent-cos.version>5.6.227</tencent-cos.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- MyBatis-Plus：统一管理持久层增强框架版本，子模块按需引入。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis 公共配置：统一管理 MyBatis-Plus 扩展能力，数据库服务按需引入。 -->
            <dependency>
                <groupId>com.zhou6</groupId>
                <artifactId>mybatis-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Springdoc OpenAPI：统一管理 Swagger UI 依赖版本。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <!-- Springdoc OpenAPI WebFlux：网关使用 WebFlux 版 Swagger UI 聚合各微服务文档。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <!-- Flowable 工作流引擎：workflow-service 使用，适配 Spring Boot 3 / Jakarta 命名空间。 -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter</artifactId>
                <version>${flowable.version}</version>
            </dependency>
            <!-- MinIO 官方 SDK。 -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- 华为云 OBS 官方 SDK。 -->
            <dependency>
                <groupId>com.huaweicloud</groupId>
                <artifactId>esdk-obs-java</artifactId>
                <version>${huaweicloud-obs.version}</version>
            </dependency>
            <!-- 阿里云 OSS 官方 SDK。 -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
            <!-- 腾讯云 COS 官方 SDK。 -->
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>${tencent-cos.version}</version>
            </dependency>
            <!-- Spring Cloud BOM：统一管理 Gateway、LoadBalancer 等 Spring Cloud 组件版本。 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM：统一管理 Nacos Discovery 等 Alibaba 生态组件版本。 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot 基础依赖：所有微服务共享 Spring Boot 运行时和自动配置能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Nacos 服务发现依赖：所有微服务统一注册到 Nacos，并支持服务发现。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心依赖：所有微服务统一从 Nacos 拉取公共配置和环境配置。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Bootstrap 启动上下文依赖：让 Spring Boot 3 / Spring Cloud 2023 正确加载 bootstrap.yml。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- Spring Boot 测试依赖：所有微服务共享 JUnit、断言和 Spring 测试工具。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven 插件：所有微服务统一打包成可执行 jar。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Maven 编译插件：明确使用 Java 21 编译所有子模块，避免被外部 settings 覆盖。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
